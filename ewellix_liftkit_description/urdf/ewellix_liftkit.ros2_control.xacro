<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="ewellix_liftkit_ros2_control" params="
    name
    tf_prefix:=''
    use_fake_hardware:=false
    use_gazebo:=false
    com_port_top:=/dev/ttyACM0
    com_port_bottom:=/dev/ttyACM1
    height_limit:=0.6
    initial_value:=0.0
    calibration_direction:=none
    max_ticks_mot_1:=871
    max_ticks_mot_2:=870
    min_height_m:=0.048000
    max_height_m:=0.587000
    homing_current_a:=0.5
    stall_velocity_thresh:=5
    stall_time_ms:=400
    homing_timeout_ms:=15000
    poll_ms:=20
    backoff_counts:=500
    top_home_direction:=1
    bottom_home_direction:=1
    motor_acceleration:=100
    motor_deceleration:=100
    motor_stop_decel:=100
    motor_speed_profile:=100">

    <!-- Single system controlling both motors -->
    <xacro:if value="${not (use_fake_hardware or use_gazebo)}">
      <!-- REAL HARDWARE -->
      <ros2_control name="ewellix_liftkit" type="system">
        <hardware>
          <plugin>liftkit_hardware_interface/ElmoLiftkitHardwareInterface</plugin>
          <param name="com_port_top">${com_port_top}</param>
          <param name="com_port_bottom">${com_port_bottom}</param>
          <param name="min_height_m">${min_height_m}</param>
          <param name="max_height_m">${max_height_m}</param>
          <param name="max_ticks_mot_1">${max_ticks_mot_1}</param>
          <param name="max_ticks_mot_2">${max_ticks_mot_2}</param>
          <param name="homing_current_a">${homing_current_a}</param>
          <param name="stall_velocity_thresh">${stall_velocity_thresh}</param>
          <param name="stall_time_ms">${stall_time_ms}</param>
          <param name="homing_timeout_ms">${homing_timeout_ms}</param>
          <param name="poll_ms">${poll_ms}</param>
          <param name="backoff_counts">${backoff_counts}</param>
          <param name="top_home_direction">${top_home_direction}</param>
          <param name="bottom_home_direction">${bottom_home_direction}</param>
          <param name="calibration_direction">${calibration_direction}</param>
          <param name="height_limit">${height_limit}</param>
          <!-- === ADD THESE 4 LINES === -->
          <param name="motor_acceleration">${motor_acceleration}</param>
          <param name="motor_deceleration">${motor_deceleration}</param>
          <param name="motor_stop_decel">${motor_stop_decel}</param>
          <param name="motor_speed_profile">${motor_speed_profile}</param>
          <!-- ========================= -->
        </hardware>
        <joint name="${tf_prefix}ewellix_lift_lower_to_higher">
          <command_interface name="position">
            <param name="min">${min_height_m}</param>
            <param name="max">${max_height_m}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>
    </xacro:if>

    <!-- FAKE HARDWARE -->
    <xacro:if value="${use_fake_hardware}">
      <ros2_control name="ewellix_liftkit" type="system">
        <hardware>
          <plugin>liftkit_hardware_interface/ElmoLiftkitHardwareInterface</plugin>
          <param name="com_port_top">/dev/null</param>
          <param name="com_port_bottom">/dev/null</param>
          <param name="min_height_m">${min_height_m}</param>
          <param name="max_height_m">${max_height_m}</param>
          <param name="max_ticks_mot_1">${max_ticks_mot_1}</param>
          <param name="max_ticks_mot_2">${max_ticks_mot_2}</param>
          <param name="homing_current_a">${homing_current_a}</param>
          <param name="stall_velocity_thresh">${stall_velocity_thresh}</param>
          <param name="stall_time_ms">${stall_time_ms}</param>
          <param name="homing_timeout_ms">${homing_timeout_ms}</param>
          <param name="poll_ms">${poll_ms}</param>
          <param name="backoff_counts">${backoff_counts}</param>
          <param name="top_home_direction">${top_home_direction}</param>
          <param name="bottom_home_direction">${bottom_home_direction}</param>
          <param name="calibration_direction">${calibration_direction}</param>
          <param name="height_limit">${height_limit}</param>
          <!-- === ADD THESE 4 LINES === -->
          <param name="motor_acceleration">${motor_acceleration}</param>
          <param name="motor_deceleration">${motor_deceleration}</param>
          <param name="motor_stop_decel">${motor_stop_decel}</param>
          <param name="motor_speed_profile">${motor_speed_profile}</param>
          <!-- ========================= -->
        </hardware>
        <joint name="${tf_prefix}ewellix_lift_lower_to_higher">
          <command_interface name="position">
            <param name="min">${min_height_m}</param>
            <param name="max">${max_height_m}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>
    </xacro:if>

  </xacro:macro>

</robot>